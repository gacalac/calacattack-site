+	if (selected) {
+	    chip.style.backgroundColor = regionColor(region);
+	}
+	chip.title = 'Region ' + regionNumber(region) + ' (' + modelName(region.fit) + ')';
+	chip.textContent = String(regionNumber(region));
+	chip.addEventListener('click', function(e) {
