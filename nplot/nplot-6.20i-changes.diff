+
+/* ************************************************************************ */
+/* iPad edition (6.20i) additions                                           */
+/* ************************************************************************ */
+
+/* Safari on iPads gives text inputs its own padding, border, rounded corners and font.  That made the X/Y label rows
+   a few pixels too wide, so the closing parenthesis wrapped to its own line.  Normalize the inputs and keep each
+   label row on one line, letting the text boxes shrink slightly if they have to. */
+input[type="text"], input[type="number"], input:not([type]), textarea {
+    -webkit-appearance: none;
+    appearance: none;
+    border-radius: 0;
+    -webkit-user-select: text;
+    user-select: text;
+}
+
+.labelRow {
+    white-space: nowrap;
+    flex-wrap: nowrap;
+    align-items: baseline;
+}
+
+.labelClass {
+    box-sizing: content-box;
+    font-family: Arial, Helvetica, sans-serif;
+    font-size: 13.33px;
+    padding: 0 2px 1px 2px;
+    margin: 0;
+    border-top: 0;
+    border-left: 0;
+    border-right: 0;
+    flex: 0 1 auto;
+    min-width: 20px;
+}
+
+.cellClass, .guess {
+    font-family: Arial, Helvetica, sans-serif;
+    margin: 0;
+}
+
+/* buttons: no iOS long-press callout or text-selection loupe, and no double-tap-to-zoom delay */
+button, .npButton, .sheetButton, .modelButton, .radioButton, #canvas1 {
+    -webkit-touch-callout: none;
+    -webkit-user-select: none;
+    user-select: none;
+    touch-action: manipulation;
+    -webkit-tap-highlight-color: transparent;
+}
+
+/* tangent finder: Copy Slopes button, and readout text that can be selected */
+#tangentControls {
+    align-items: center;
+}
+
+#copySlopesButton {
+    font-size: 12px;
+    padding: 3px 6px;
+    border-width: 1px;
+}
+
+#slopeResults {
+    -webkit-user-select: text;
+    user-select: text;
+}
+
+/* recall panel: Save to File / Open File, and a delete control on each saved graph */
+#fileButtons {
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+    padding: 0 20px 10px 28px;
+}
+
+.fileButton {
+    width: 190px;
+}
+
+#savedGraphsHeading, .noSavedGraphs {
+    font-family: sans-serif;
+    font-size: 14px;
+    color: var(--hoverColor);
+    margin: 10px 20px 8px 28px;
+    white-space: nowrap;
+}
+
+#recallSavedGraphContent li {
+    display: flex;
+    flex-direction: row;
+    justify-content: space-between;
+    align-items: center;
+    padding-right: 10px;
+}
+
+.savedGraphName {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    max-width: 170px;
+}
+
+.delGraph {
+    color: #818181;
+    font-size: 26px;
+    line-height: 20px;
+    padding: 4px 6px;
+    margin-left: 6px;
+}
+
+@media (hover: hover) {
+    .delGraph:hover {
+	color: var(--alertColor);
+    }
+}
+
+/* press-and-hold menus */
+#leftButtonsTopRow, #leftButtonsBottomRow {
+    position: relative;
+}
+
+#actionMenu {
+    display: none;
+    position: absolute;
+    z-index: 5;
+    min-width: 220px;
+    background-color: var(--modalColor);
+    border: 2px solid var(--fontColor);
+    border-radius: 8px;
+    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
+    padding: 4px 0;
+}
+
+.actionMenuItem {
+    display: block;
+    width: 100%;
+    text-align: left;
+    background: none;
+    border: 0;
+    padding: 10px 14px;
+    font-family: bahnschrift, 'DIN Alternate', sans-serif;
+    font-size: 15px;
+    color: var(--fontColor);
+    cursor: pointer;
+    white-space: nowrap;
+}
+
+.actionMenuItem:active {
+    background-color: var(--selectedColor);
+}
+
+@media (hover: hover) {
+    .actionMenuItem:hover {
+	background-color: var(--selectedColor);
+    }
+}
+
+/* short messages */
+#toastMessage {
+    display: none;
+    position: fixed;
+    z-index: 10;
+    left: 50%;
+    bottom: 40px;
+    transform: translateX(-50%);
+    max-width: 640px;
+    padding: 12px 18px;
+    background-color: var(--fontColor);
+    color: #FFFFFF;
+    border-radius: 10px;
+    font-family: bahnschrift, 'DIN Alternate', sans-serif;
+    font-size: 16px;
+    text-align: center;
+    box-shadow: 0 4px 14px rgba(0,0,0,0.3);
+}
+
+/* graph-as-image and copy-by-hand pop-ups */
+#graphImageContent {
+    width: 520px;
+    text-align: center;
+}
+
+#graphImage {
+    width: 480px;
+    height: auto;
+    border: 1px solid var(--cellBorderColor);
+    -webkit-touch-callout: default;
+    -webkit-user-select: auto;
+    user-select: auto;
+}
+
+#copyTextContent {
+    width: 420px;
+}
+
+#copyTextArea {
+    width: 100%;
+    box-sizing: border-box;
+    font-family: Menlo, Consolas, monospace;
+    font-size: 15px;
+    border: 2px solid var(--fontColor);
+    padding: 6px;
+}
+
+/* front-panel link to CalacAttack.com (replaces the noragulfa.com logo) */
+#logoPanel {
+    align-items: flex-end;
+}
+
+#homeLink {
+    font-family: bahnschrift, 'DIN Alternate', sans-serif;
+    font-size: 15px;
+    font-weight: 600;
+    color: var(--fontColor);
+    text-decoration: none;
+    padding-bottom: 4px;
+}
+
+@media (hover: hover) {
+    #homeLink:hover {
+	text-decoration: underline;
+    }
+}
